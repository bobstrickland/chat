<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-requested on API 33+ (MainActivity); implicitly granted below that. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hijaca">

        <!-- Launcher: the app starts at login; MainActivity is entered after auth. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Catches the Cognito Hosted-UI redirect back into the app after Google sign-in. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myapp" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- singleTop: tapping a push while the app is already open delivers the
             intent to the running instance (onNewIntent) instead of stacking a
             second MainActivity. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- FCM push. Inert unless google-services.json was present at build time. -->
        <service
            android:name=".push.ChatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Used by Play services when IT draws the notification (app backgrounded
             or killed) — must match what Notifications.showMessage uses so the two
             paths look identical, and must name a channel the app has created. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_chat" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
    </application>
</manifest>
