<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV ONLY. Android blocks cleartext HTTP by default (API 28+). The local backend
  runs over plain HTTP, and the emulator reaches the host machine at 10.0.2.2.
  Allow cleartext to the local hosts only. Remove/replace for a real deployment
  (which will be HTTPS behind CloudFront / API Gateway).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
