<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shape system: generous 16–24dp rounding per the design brief. -->
    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Cards: soft container fill, low tonal elevation, 24dp corners. -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- Outlined text fields with 16dp corners. -->
    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLowest</item>
    </style>

    <!-- Buttons: pill-ish, 16dp corners, comfortable height. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Circular avatar chip (initials). -->
    <style name="Widget.App.Avatar" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:background">@drawable/bg_avatar</item>
    </style>
</resources>
